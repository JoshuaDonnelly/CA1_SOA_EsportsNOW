@inherits LayoutComponentBase

<div class="page">
    

    <main>
        <header>
            <div class="header-left">
                <NavLink class = "nav-link" href="" Match="NavLinkMatch.All">
                <span class="headerLinks">Esports Central</span>
                </NavLink>
            </div>
            <div class="header-right">
                <NavLink class = "nav-link" href = "Stream">
                    <span class ="headerLinks">Twitch Streams</span>
                </NavLink>
                <a class="headerLinks" href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div>
        </header>

        <div class="content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
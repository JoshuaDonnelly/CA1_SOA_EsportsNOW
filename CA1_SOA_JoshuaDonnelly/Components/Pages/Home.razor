@page "/"
@using CA1_SOA_JoshuaDonnelly.Models
@inject NavigationManager Navigation


<PageTitle>Esports Matches</PageTitle>

@if (!shouldRender)
{
    <p class = "loadingText">Loading upcoming matches...</p>
}
else if (getMatchesError)
{
    <p class = "errorTextOnLoad">There was an error retrieving the Esports Data...</p>
}
else if (shouldRender && Matches == null || shouldRender && !Matches.Any())
{
    <p class = "errorTextOnLoad">No upcoming matches available...</p>
}
else
{
    
    <h1 class = "EsportsMatchHeading">Upcoming Esports Matches</h1>
    
    <div class = "matchSearch">
        <input class="esportsSearchBox" type = "search" @bind="SearchTextMatches" @bind:event = "oninput" placeholder = "Search Esports Matches" />
        <select class="esportsFilterBox" @bind="SelectedGameEsports">
            <option value = "All">All Games</option>
            @foreach (var game in PandaScoreService.SupportedGames)
            {
                <option value = "@game">@game</option>
            }
        </select>
    </div>
    @if (FilteredMatches.Count() == 0)
    {
        <p class="errorTextOnLoad">Nothing Found with your Search</p>
    }
    
    @foreach (var match in FilteredMatches)
    {
        
        <div class="card gameCard"
             style="cursor: pointer;"
             @onclick='() => OpenGame(match.Game)'>

            <h4>@match.Game</h4>
            <div class="teamsContainer">
                <img alt="T1 Image" class="teamImage" src="@match.TeamOneImage"><p class="teamOne">@match.TeamOne</p>
                <p class="versus">VS</p>
                <p class="teamTwo">@match.TeamTwo</p><img alt ="T2 Image" class="teamImage" src="@match.TeamTwoImage">
            </div>
            <p>@match.Tournament</p>
            <p>@match.StartTime</p>
        </div>
        
    }
    <div class = "divider"></div>
}

@if (!shouldRender)
{
    
}

else if (getStreamsError)
{
    <p class = "errorTextOnLoad">There was an error retrieving Twitch streams.</p>
}
else if (LiveStreams.Count == 0)
{
    <p class = "errorTextOnLoad">No matching live streams were found.</p>
}
else
{
    <h1 class = "EsportsMatchHeading">Live Streams for Ongoing Esports Games</h1>
    
    <div class="streamSearch">
        
        <input class="esportsSearchBox" type="search" @bind="SearchTextStreams" @bind:event="oninput" placeholder="Search Live Streams"/>

        <select class="esportsFilterBox" @bind="SelectedNameStreams">

            <option value="All">All Streamers</option>
            @foreach (var userName in LiveStreams
                          .Select(stream => stream.UserName)
                          .Where(name => !string.IsNullOrWhiteSpace(name))
                          .Distinct())
            {
                <option value="@userName">@userName</option>
            }

        </select>
    </div>
    @if (!FilteredStreams.Any())
    {
        <p class = "errorTextOnLoad">No Matching Live Streams</p>
    }
    else
    {
        <div class="streamContainer">


            @foreach (var stream in FilteredStreams)
            {
                <div class="card streamCard">

                    @if (!string.IsNullOrWhiteSpace(stream.ThumbnailUrl))
                    {
                        <img src="@stream.ThumbnailUrl"
                             alt="Stream Thumbnail for @stream.UserName"
                             class="streamCardImage"/>
                    }
                    <h4 class="streamUser">@stream.UserName</h4>
                    <p class="streamTitle"> @stream.Title</p>
                    <p>Viewers:
                        @stream.ViewerCount</p>

                    <a href="@($"https://www.twitch.tv/{stream.UserLogin}")"
                       target="_blank"
                       rel="noopener noreferrer">
                        Watch on Twitch
                    </a>
                </div>
            }

        </div>
    }
}


@code
{
    private List<TwitchStreams> LiveStreams = new();
    private bool getStreamsError;
    private IEnumerable<EsportsMatches>? Matches = [];
    private bool getMatchesError;
    private bool shouldRender;
    private string SearchTextMatches = "";
    private string SearchTextStreams = "";
    private string SelectedGameEsports = "All";
    private string SelectedNameStreams = "All";
    
    
    
    // Searching
    private IEnumerable<EsportsMatches> FilteredMatches =>
        
        (Matches ??  Enumerable.Empty<EsportsMatches>()) 
    
        .Where(match =>
            // Filter matches
            (SelectedGameEsports == "All" ||
             string.Equals(
                 match.Game,
                 SelectedGameEsports,
                 StringComparison.OrdinalIgnoreCase))
            
            &&
            
            // Search Matches
            (string.IsNullOrWhiteSpace(SearchTextMatches) ||
            (match.Game?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
            (match.TeamOne?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
            (match.TeamTwo?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
            (match.Tournament?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false))
            
        );
    
    private IEnumerable<TwitchStreams> FilteredStreams =>
        
        LiveStreams.Where(stream =>
            // Filter streams
            (SelectedNameStreams == "All" ||
                string.Equals(
                    stream.UserName,
                    SelectedNameStreams,
                    StringComparison.OrdinalIgnoreCase))
        &&
        
        
            (string.IsNullOrWhiteSpace(SearchTextStreams) ||
            (stream.Title?.Contains(SearchTextStreams, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
            (stream.UserName?.Contains(SearchTextStreams, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
            (stream.GameName?.Contains(SearchTextStreams, StringComparison.InvariantCultureIgnoreCase) ?? false)));
    
    
    [Inject]
    public IConfiguration Configuration  { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Matches = await PandaScoreService.GetUpcomingMatchesAsync(Configuration);
            
            

            if (Matches == null || !Matches.Any())
            {
                getMatchesError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            getMatchesError = true;
        }
        shouldRender = true;

        if (Matches != null && Matches.Any())
        {
            try
            {
                var gameNames = Matches.Select(m => m.Game);
                LiveStreams = await TwitchStreamService.GetStreamsForGamesAsync(Configuration, gameNames);
            }
            catch (Exception ex)
            {
                getStreamsError = true;
                Console.WriteLine(ex);
            }
        }
    }
    private void OpenGame(string gameName)
    {
        Console.WriteLine($"Clicked game: {gameName}");
        Navigation.NavigateTo($"/game/{Uri.EscapeDataString(gameName)}");
    }
    
    
}

@page "/"
@using CA1_SOA_JoshuaDonnelly.Models
@inject NavigationManager Navigation


<PageTitle>Esports Matches</PageTitle>

@if (!shouldRender)
{
    <p class = "loadingText">Loading upcoming matches...</p>
}
else if (getMatchesError)
{
    <p class = "errorTextOnLoad">There was an error retrieving the Esports Data...</p>
}
else if (shouldRender && Matches == null || shouldRender && !Matches.Any())
{
    <p class = "errorTextOnLoad">No upcoming matches available...</p>
}
else
{
    <h1 class = "EsportsMatchHeading">Upcoming Esports Matches</h1>
    
    <div class = "matchSearch">
        <input class="esportsSearchBox" type = "search" @bind="SearchTextMatches" @bind:event = "oninput" placeholder = "Search Esports Matches" />
        <select class="esportsFilterBox" @bind="SelectedGameEsports">
            <option value = "All">All Games</option>
            @foreach (var game in PandaScoreService.SupportedGames)
            {
                <option value = "@game">@game</option>
            }
        </select>
    </div>
    @if (FilteredMatches.Count() == 0)
    {
        <p class="errorTextOnLoad">Nothing Found with your Search</p>
    }
    
    @foreach (var match in FilteredMatches)
    {
        <div class="card gameCard"
             style="cursor: pointer;"
             @onclick='() => OpenGame(match.Game)'>

            <h4>@match.Game</h4>
            <div class="teamsContainer">
                <img alt="T1 Image" class="teamImage" src="@match.TeamOneImage"><p class="teamOne">@match.TeamOne</p>
                <p class="versus">VS</p>
                <p class="teamTwo">@match.TeamTwo</p><img alt ="T2 Image" class="teamImage" src="@match.TeamTwoImage">
            </div>
            <p>@match.Tournament</p>
            <p>@match.StartTime</p>
        </div>
    }
}

@code
{
    private IEnumerable<EsportsMatches>? Matches = [];
    private bool getMatchesError;
    private bool shouldRender;
    private string SearchTextMatches = "";
    private string SelectedGameEsports = "All";
    
    // Searching
    private IEnumerable<EsportsMatches> FilteredMatches =>

        (Matches ?? Enumerable.Empty<EsportsMatches>())

        .Where(match =>
            // Filter matches
            (SelectedGameEsports == "All" ||
             string.Equals(
                 match.Game,
                 SelectedGameEsports,
                 StringComparison.OrdinalIgnoreCase))

            &&

            // Search Matches
            (string.IsNullOrWhiteSpace(SearchTextMatches) ||
             (match.Game?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
             (match.TeamOne?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
             (match.TeamTwo?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
             (match.Tournament?.Contains(SearchTextMatches, StringComparison.InvariantCultureIgnoreCase) ?? false))

        );


    [Inject] public IConfiguration Configuration { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Matches = await PandaScoreService.GetUpcomingMatchesAsync(Configuration);
            
            if (Matches == null || !Matches.Any())
            {
                getMatchesError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            getMatchesError = true;
        }

        shouldRender = true;
        
    }

    private void OpenGame(string gameName)
    {
        Console.WriteLine($"Clicked game: {gameName}");
        Navigation.NavigateTo($"/game/{Uri.EscapeDataString(gameName)}");
    }


}

@page "/"
@using CA1_SOA_JoshuaDonnelly.Models


<PageTitle>Esports Matches</PageTitle>

<h1 class = "EsportsMatchHeading">Upcoming Esports Matches</h1>

@if (!shouldRender)
{
    <p>Loading upcoming matches...</p>
}
else if (getMatchesError)
{
    <p>There was an error retrieving the Esports Data...</p>
}
else if (Matches == null || !Matches.Any())
{
    <p>No upcoming matches available...</p>
}
else
{
    @foreach (var match in Matches)
    {
        <div class="card gameCard">
            <h4>@match.Game</h4>
            <div class = "teamsContainer">
                <img class = "teamImage" src = "@match.TeamOneImage"><p class = "teamOne">@match.TeamOne</p>
                <p class = "versus">VS</p>
                <p class = "teamTwo">@match.TeamTwo</p><img class = "teamImage" src = "@match.TeamTwoImage">
            </div>
            <p>@match.Tournament</p>
            <p>@match.StartTime</p>
        </div>
    }
}

@code
{
    private IEnumerable<EsportsMatches>? Matches = [];
    private bool getMatchesError;
    private bool shouldRender;

    protected override bool ShouldRender() => shouldRender;
    
    [Inject]
    public IConfiguration Configuration  { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Matches = await PandaScoreService.GetUpcomingMatchesAsync(Configuration);

            if (Matches == null || !Matches.Any())
            {
                getMatchesError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            getMatchesError = true;
        }
        shouldRender = true;
    }
    
}

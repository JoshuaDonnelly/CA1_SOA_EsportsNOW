@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject TwitchStreamService TwitchStreamService
@page "/Stream"
@using CA1_SOA_JoshuaDonnelly;
@using CA1_SOA_JoshuaDonnelly.Models
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


@if (!shouldRender)
{
    <p class = "loadingText">Twitch Streams Loading...</p>
}

else if (getStreamsError)
{
    <p class = "errorTextOnLoad">There was an error retrieving Twitch streams.</p>
}
else if (LiveStreams.Count == 0)
{
    <p class = "errorTextOnLoad">No matching live streams were found.</p>
}
else
{
    <div class="gameFilterOpener" @onclick="handleGameOpener">
        <div class ="gameFilterLeft">Game Filter</div>
        <i class ="fa fa-chevron-down gameFilterRight" style="font-size:8px"></i>
    </div>
    @if (isGameFilterOpen)
    {
        <div class="streamContainer" @bind="isGameFilterOpen">
            @foreach (var game in Games)
            {
                <div class="card streamCard" @onclick="() => OpenGameDetails(game.Name)">

                    <img src="@game.ImageURL"
                         alt="@game.Name"
                         class="gameCardImage"/>

                    <h4>@game.Name</h4>

                    <p>Total Live Viewers: @game.totalViewers.ToString("N0")</p>
                </div>
            }
        </div>
    }

    <div class="divider"></div>

    <h1 class = "EsportsMatchHeading">All Live Streams for Ongoing Esports Games</h1>
    
    <div class="streamSearch">
        <div class = "filterControl">
            <input class="esportsSearchBox" type="search" @bind="SearchTextStreams" @bind:event="oninput" placeholder="Search Live Streams"/>
        </div>
        
        <div class = "filterControl">
            <label for="streamFilter">Filter by Streamer</label>
                <select id="streamFilter" class="esportsFilterBox" @bind="SelectedNameStreams">
                    <option value="All">All Streamers</option>
                    @foreach (var userName in LiveStreams
                                  .Select(stream => stream.UserName)
                                  .Where(name => !string.IsNullOrWhiteSpace(name))
                                  .Distinct())
                    {
                        <option value="@userName">@userName</option>
                    }
                </select>
        </div>
        <div class = "filterControl">
            <label for="streamSort">Sort by Viewers</label>
                <select id="streamSort" class="esportsFilterBox" @bind="SelectedViewerSort"> <br />
                    <option value = "Most">Most Viewers</option>
                    <option value = "Least">Fewest Viewers</option>
                </select>
        </div>
    </div>
    @if (!FilteredStreams.Any())
    {
        <p class = "errorTextOnLoad">No Matching Live Streams</p>
    }
    else
    {
        
        
        <div class="streamContainer">


            @foreach (var stream in FilteredStreams)
            {
                <div class="card streamCard">

                    @if (!string.IsNullOrWhiteSpace(stream.ThumbnailUrl))
                    {
                        <img src="@stream.ThumbnailUrl"
                             alt="Stream Thumbnail for @stream.UserName"
                             class="streamCardImage"/>
                    }
                    <h4 class="streamUser">@stream.UserName</h4>
                    <p class="streamTitle"> @stream.Title</p>
                    <p>Viewers:
                        @stream.ViewerCount</p>

                    <a href="@($"https://www.twitch.tv/{stream.UserLogin}")"
                       target="_blank"
                       rel="noopener noreferrer">
                        Watch on Twitch
                    </a>
                </div>
            }
            

        </div>
    }
}
@code {

    private List<TwitchStreams> LiveStreams = new();
    private bool getStreamsError;
    private bool shouldRender;
    private string SelectedNameStreams = "All";
    private string SelectedViewerSort = "Most";
    private string SearchTextStreams = "";
    private bool isGameFilterOpen = false;

    private List<Games> Games = new()
    {
        new Games
        {
            Name = "Counter-Strike",
            ImageURL = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT7AFeVyN8KEelfhLqc9oYmwBT8NHhNX3ja_MpRGpM-Y6BU6hCTDkVbTEU&s=10"
        },
        new Games
        {
            Name = "Dota 2",
            ImageURL = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTrGVbShTUjsVD-ZBeYsZK1GKcJCcN5K-ybQKno4OAMaMtG5IQBvNoL1FQ&s=10"
        },
        new Games
        {
            Name = "Valorant",
            ImageURL = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQdSEHoBNfqSz-qMT03KmgFrC9aLwYFqpCCWu7CJtLT72po2muLlB64C9tS&s=10"
        },
        new Games
        {
            Name = "Rainbow Six Siege",
            ImageURL = "https://mlpnk72yciwc.i.optimole.com/cqhiHLc.IIZS~2ef73/w:auto/h:auto/q:75/https://bleedingcool.com/wp-content/uploads/2024/02/Rainbow-Six-Siege-Year-9-Artwork.jpg"
        },
        new Games
        {
            Name = "League Of Legends",
            ImageURL = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTwSibefyd6mrgK_DsOI6bM6o6NzEDgWNWKZBwgTDo9urI-5R5RNm_EzKH2&s=10"
        }
    };

    private void UpdateGameViewers()
    {
        foreach (var game in Games)
        {
            game.totalViewers = GameViewerCalc.GetTotalViewers(LiveStreams, game.Name);
        }
    }

    private void OpenGameDetails(string gameName)
    {
        Navigation.NavigateTo($"/game/{Uri.EscapeDataString(gameName)}");
    }

    private void handleGameOpener()
    {
        if (!isGameFilterOpen)
        {
            isGameFilterOpen = true;
        }
        else
        {
            isGameFilterOpen = false;
        }
    }

    private IEnumerable<TwitchStreams> FilteredStreams =>

        LiveStreams.Where(stream =>
                // Filter streams
                (SelectedNameStreams == "All" ||
                 string.Equals(
                     stream.UserName,
                     SelectedNameStreams,
                     StringComparison.OrdinalIgnoreCase))
                &&


                (string.IsNullOrWhiteSpace(SearchTextStreams) ||
                 (stream.Title?.Contains(SearchTextStreams, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
                 (stream.UserName?.Contains(SearchTextStreams, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
                 (stream.GameName?.Contains(SearchTextStreams, StringComparison.InvariantCultureIgnoreCase) ?? false)))

            // Sort by viewer count
            .OrderBy(stream => SelectedViewerSort == "Most"
                ? -stream.ViewerCount
                : stream.ViewerCount);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var gameNames = new List<string>
            {
                "Counter-Strike",
                "League of Legends",
                "Rainbow Six Siege",
                "Valorant",
                "Dota 2"
            };


            LiveStreams = await TwitchStreamService
                .GetStreamsForGamesAsync(Configuration, gameNames);

            UpdateGameViewers();
        }
        catch (Exception ex)
        {
            getStreamsError = true;
            Console.WriteLine(ex);
        }
        finally
        {
            shouldRender = true;
        }
    }

}
}